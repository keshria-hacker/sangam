/* =========================================================================
   NEXUS — Universal AI Chat Platform
   Paper / Ink design system
   -------------------------------------------------------------------------
   PAPER (light): warm paper whites · graphite ink · thin borders
   INK   (dark):  deep charcoal · graphite · soft white
   Chrome is intentionally monochrome. Color is rare and semantic.
   Display: Sora · Body: Inter · Mono: JetBrains Mono
   ========================================================================= */

/* Smooth theme transition on html element */
html{transition:background var(--dur-med) var(--ease);}

/* ---------- Shared tokens ---------- */
:root{
  --font-display:'Sora', ui-sans-serif, system-ui, sans-serif;
  --font-body:'Inter', ui-sans-serif, system-ui, sans-serif;
  --font-mono:'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

  --radius-sm:8px;
  --radius-md:14px;
  --radius-lg:20px;
  --radius-xl:26px;

  --ease:cubic-bezier(.4,0,.2,1);
  --dur-fast:120ms;
  --dur-med:200ms;

  --sidebar-w:280px;
  --sidebar-w-collapsed:60px;

  --font-scale:1;
  --chat-max-w:760px;

  /* Surface hierarchy — semantic aliases so raised/sunken layers stay
     consistent across the chrome, cards, popovers and dialogs (§7). */
  --surface-page:var(--bg-base);        /* page ground */
  --surface-panel:var(--bg-surface);    /* app chrome: sidebar, topbar */
  --surface-raised:var(--bg-elevated);  /* cards, popovers, dropdowns, modals */
  --surface-sunken:var(--bg-elevated-2);/* wells, active rows, inset fields */
}

/* ---------- PAPER — light theme ---------- */
[data-theme="light"]{
  /* Fixed ink accent — monochrome chrome (no brand hue) */
  --accent:#3A342B;          /* deep warm ink */
  --logo-filter:brightness(0);
  --accent-rgb:58,52,43;
  --accent-soft:#C7C0B1;     /* muted warm gray — WCAG AA on accent */
  --on-accent:#FBFAF7;       /* text on accent fill */

  --bg-base:#F4F2ED;          /* warm paper */
  --bg-surface:#FBFAF7;       /* soft off-white */
  --bg-elevated:#FEFDF9;      /* raised card — warm off-white, never pure #FFF */
  --bg-elevated-2:#EDEAE3;    /* subtle gray */
  --bg-elevated-3:#E5E1D9;    /* deeper gray for inline code */
  --bg-hover:#F1EFEA;
  --bg-active:#E7E3D9;
  --border:#DCD7CC;
  --border-strong:#C7C0B1;
  --border-soft:#E6E2D8;
  --text-primary:#201D17;     /* near-black warm ink */
  --text-secondary:#5A554A;
  --text-tertiary:#6A6458;    /* WCAG AA on bg-base */
  --text-disabled:#858074;    /* WCAG AA large text on bg-base */
  --input-bg:#FEFDF9;
  --user-bubble:#E9E5DA;      /* monochrome user surface */
  --focus-ring:rgba(var(--accent-rgb),.45);
  --glass-bg:rgba(251,250,247,.9);
  --composer-bg:rgba(254,253,249,.94);
  --shadow-1:0 1px 2px rgba(45,40,30,.06);
  --shadow-2:0 6px 18px rgba(45,40,30,.09);
  --shadow-3:0 20px 48px rgba(45,40,30,.14);
  --scrollbar:rgba(32,29,23,.22);

  /* Code-block chrome */
  --code-block-bg:#F0EDE6;
  --code-block-border-hover:rgba(0,0,0,.16);
  --code-block-header-bg:rgba(0,0,0,.035);
  --code-block-header-border:rgba(0,0,0,.07);
  --code-block-btn-hover-bg:rgba(0,0,0,.06);

  /* Semantic color — WCAG AA compliant */
  --success:#1E7D2D;
  --success-soft:rgba(30,125,45,.13);
  --warning:#965F19;
  --warning-soft:rgba(150,95,25,.14);
  --danger:#B23333;
  --danger-soft:rgba(178,51,51,.11);
  --danger-strong:#A63636;
  --on-danger:#FFF9F8;
  --info:#2F6FB3;
  --info-soft:rgba(47,111,179,.13);
  --reasoning:#7752CE;
  --reasoning-soft:rgba(119,82,206,.12);

  /* Syntax highlighting (github-light palette) */
  --hljs-color:#24292e;
  --hljs-keyword:#d73a49;
  --hljs-string:#032f62;
  --hljs-number:#005cc5;
  --hljs-comment:#6a737d;
  --hljs-title:#6f42c1;
  --hljs-type:#005cc5;
  --hljs-attr:#005cc5;
  --hljs-variable:#e36209;
  --hljs-built_in:#005cc5;
  --hljs-meta:#6a737d;
  --hljs-doctag:#d73a49;
}

/* ---------- INK — dark theme ---------- */
[data-theme="dark"]{
  /* Fixed ink accent — monochrome chrome (no brand hue) */
  --accent:#E6E4DE;          /* soft warm white */
  --logo-filter:brightness(0) invert(1);
  --accent-rgb:230,228,222;
  --accent-soft:#3A3B41;     /* border-strong — WCAG AA on accent */
  --on-accent:#201D17;       /* text on accent fill */

  --bg-base:#121315;          /* deep charcoal */
  --bg-surface:#191A1D;       /* graphite */
  --bg-elevated:#202125;
  --bg-elevated-2:#28292E;
  --bg-elevated-3:#2E2F34;    /* deeper gray for inline code */
  --bg-hover:#26272B;
  --bg-active:#2E2F34;
  --border:#2C2D32;
  --border-strong:#3A3B41;
  --border-soft:#24252A;
  --text-primary:#EAE9E4;     /* soft white */
  --text-secondary:#A3A29B;
  --text-tertiary:#8E8D86;    /* WCAG AA on bg-base */
  --text-disabled:#6E6D66;    /* WCAG AA large text on bg-base */
  --input-bg:#202125;
  --user-bubble:#242529;
  --focus-ring:rgba(var(--accent-rgb),.6);
  --glass-bg:rgba(25,26,29,.92);
  --composer-bg:rgba(32,33,37,.9);
  --shadow-1:0 1px 2px rgba(0,0,0,.32);
  --shadow-2:0 8px 24px rgba(0,0,0,.42);
  --shadow-3:0 22px 60px rgba(0,0,0,.55);
  --scrollbar:rgba(255,255,255,.16);

  /* Code-block chrome */
  --code-block-bg:#1A1B1F;
  --code-block-border-hover:rgba(255,255,255,.14);
  --code-block-header-bg:rgba(255,255,255,.04);
  --code-block-header-border:rgba(255,255,255,.07);
  --code-block-btn-hover-bg:rgba(255,255,255,.08);

  /* Semantic color — restrained but visible */
  --success:#54C07E;
  --success-soft:rgba(84,192,126,.14);
  --warning:#E2A13E;
  --warning-soft:rgba(226,161,62,.15);
  --danger:#EF6B6B;
  --danger-soft:rgba(239,107,107,.13);
  --danger-strong:#F28A8A;
  --on-danger:#3A1515;
  --info:#6EA8E6;
  --info-soft:rgba(110,168,230,.15);
  --reasoning:#A78BFA;
  --reasoning-soft:rgba(167,139,250,.14);

  /* Syntax highlighting (github-dark palette) */
  --hljs-color:#c9d1d9;
  --hljs-keyword:#ff7b72;
  --hljs-string:#a5d6ff;
  --hljs-number:#79c0ff;
  --hljs-comment:#8b949e;
  --hljs-title:#d2a8ff;
  --hljs-type:#ffa657;
  --hljs-attr:#79c0ff;
  --hljs-variable:#ffa657;
  --hljs-built_in:#ffa657;
  --hljs-meta:#8b949e;
  --hljs-doctag:#ff7b72;
}

/* ---------- Reset & base ---------- */
*,*::before,*::after{box-sizing:border-box;}
html,body{height:100%;}
body{
  margin:0;
  background:var(--bg-base);
  color:var(--text-primary);
  font-family:var(--font-body);
  font-size:calc(15px * var(--font-scale));
  line-height:1.55;
  -webkit-font-smoothing:antialiased;
  overflow:hidden;
  transition:background var(--dur-med) var(--ease), color var(--dur-med) var(--ease);
}
h1,h2,h3,h4{font-family:var(--font-display); margin:0;}
p{margin:0;}
button{font-family:inherit; cursor:pointer;}
input,select,textarea{font-family:inherit; color:inherit;}
a{color:var(--accent);}
::selection{background:rgba(var(--accent-rgb),.3);}

/* Scrollbars */
*{scrollbar-width:thin; scrollbar-color:var(--scrollbar) transparent;}
*::-webkit-scrollbar{width:8px; height:8px;}
*::-webkit-scrollbar-thumb{background:var(--scrollbar); border-radius:8px;}
*::-webkit-scrollbar-track{background:transparent;}

/* ---------- Utilities ---------- */
.hidden{display:none !important;}
:focus-visible{outline:3px solid var(--focus-ring); outline-offset:3px;}
.icon-btn:focus-visible,.model-option:focus-visible,.model-provider-filters button:focus-visible{outline-offset:-2px;}
.kbd{
  font-family:var(--font-mono); font-size:11px; background:var(--bg-elevated-2);
  border:1px solid var(--border); border-bottom-width:2px; border-radius:5px;
  padding:1px 6px; color:var(--text-secondary);
}

/* Accessibility utilities */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* Reduced motion support */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* High contrast mode support */
@media (prefers-contrast: high) {
  :root {
    --border: currentColor;
    --border-strong: currentColor;
    --border-soft: currentColor;
    --focus-ring: currentColor;
  }
}

/* Keyboard focus styles for message elements */
.assistant-response:focus-within,
.code-block:focus-within,
.msg-reasoning details:focus-within {
  outline: 2px solid var(--focus-ring);
  outline-offset: 2px;
  border-radius: var(--radius-sm);
}

/* Skip link for main content */
.skip-link {
  position: absolute;
  top: -100%;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10000;
  padding: 12px 24px;
  background: var(--accent);
  color: var(--on-accent);
  border-radius: var(--radius-sm);
  font-weight: 600;
  text-decoration: none;
  transition: top var(--dur-fast) var(--ease);
}
.skip-link:focus {
  top: 10px;
}

/* ---------- Buttons ---------- */
.btn-secondary{
  background:var(--bg-elevated-2); border:1px solid var(--border); color:var(--text-primary);
  padding:8px 14px; border-radius:var(--radius-sm); font-size:13px; font-weight:500; flex:0 0 auto;
  transition:background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
}
.btn-secondary:hover{background:var(--bg-hover); border-color:var(--border-strong);}
.btn-secondary:active{background:var(--bg-active);}
.btn-danger{
  background:var(--danger); color:var(--on-danger); border:none; padding:8px 18px;
  border-radius:var(--radius-sm); font-size:13px; font-weight:600;
  transition:background var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
}
.btn-danger:hover{background:var(--danger-strong);}
.btn-danger:active{transform:scale(.97);}
.btn-danger:focus-visible{outline:3px solid var(--focus-ring); outline-offset:2px;}

/* Icon button */
.icon-btn{
  width:36px; height:36px; display:inline-flex; align-items:center; justify-content:center;
  background:transparent; border:none; border-radius:var(--radius-sm); color:var(--text-secondary);
  transition:background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  -webkit-tap-highlight-color:transparent; touch-action:manipulation;
}
.icon-btn:hover{background:var(--bg-hover); color:var(--text-primary);}
.icon-btn:active{transform:scale(.92); color:var(--text-primary);}
.icon-btn.ghost:hover{background:var(--bg-hover);}
.icon-btn.ghost:active{background:var(--bg-active);}

/* Touch-friendly active states */
button:active, .model-option:active, .suggestion-card:active,
.skill-card:active, .filter-tab:active, .chat-item:active,
.theme-option:active, .segmented button:active, .pill-control:active,
.auth-submit:active, .send-btn:active{transform:scale(.97);}

/* ---------- Mobile topbar ---------- */
.mobile-topbar{
  display:none; align-items:center; justify-content:space-between;
  padding:10px 12px; background:var(--surface-panel); border-bottom:1px solid var(--border-soft);
  position:sticky; top:0; z-index:40;
}
.mobile-brand{display:flex; align-items:center; gap:8px; font-family:var(--font-display); font-weight:700;}
.logo-mark{display:inline-flex; align-items:center; justify-content:center; flex-shrink:0;}
.mobile-logo-mark{width:24px; height:24px;}
.sidebar-logo-mark{width:30px; height:30px;}
.welcome-logo-mark{width:68px; height:68px; padding:0;}
.auth-logo-mark{width:48px; height:48px;}
.auth-loading .auth-logo-mark{width:48px; height:48px;}
.app-logo{display:block; width:100%; height:100%; object-fit:contain; object-position:center; filter:var(--logo-filter);}

/* ---------- App shell ---------- */
.app-shell{display:flex; height:100vh; overflow:hidden;}

/* ---------- Sidebar ---------- */
.sidebar{
  width:var(--sidebar-w); flex:0 0 auto; background:var(--surface-panel);
  border-right:1px solid var(--border-soft);
  transition:width var(--dur-med) var(--ease), margin var(--dur-med) var(--ease);
  overflow:hidden;
}
.sidebar.collapsed{width:var(--sidebar-w-collapsed);}
.sidebar.collapsed .sidebar-inner{width:var(--sidebar-w-collapsed); padding:14px 0; overflow:hidden; align-items:center;}
.sidebar.collapsed .brand-name,
.sidebar.collapsed .chat-history-label,
.sidebar.collapsed .chat-item span,
.sidebar.collapsed .sidebar-footer-btn span,
.sidebar.collapsed .kbd-hint,
.sidebar.collapsed .profile-meta,
.sidebar.collapsed .profile-section > i,
.sidebar.collapsed .sidebar-search,
.sidebar.collapsed .new-chat-btn span,
.sidebar.collapsed .chat-item-pin,
.sidebar.collapsed .chat-item-menu-btn,
.sidebar.collapsed .new-chat-btn .kbd-hint{display:none;}

.sidebar.collapsed .sidebar-header{justify-content:center; gap:0; padding:4px 0 14px;}
.sidebar.collapsed .brand{justify-content:center; width:auto;}
.sidebar.collapsed .new-chat-btn{justify-content:center; width:42px; height:42px; padding:0; border-radius:13px; margin-left:auto; margin-right:auto;}
.sidebar.collapsed .new-chat-btn i{margin:0;}
.sidebar.collapsed .chat-item{justify-content:center; padding:12px 0;}
.sidebar.collapsed .sidebar-footer{padding-top:14px;}
.sidebar.collapsed .chat-history{padding:0;}
.sidebar.collapsed .sidebar-footer-btn{justify-content:center; padding:10px 0;}
.sidebar.collapsed .profile-section{justify-content:center; padding:10px 0;}
.sidebar.collapsed .chat-item.active::before{left:50%; transform:translateX(-50%); top:8px; bottom:8px; width:3px;}
.sidebar.collapsed #collapseSidebar{display:none;}
.sidebar.collapsed .chat-item-menu-btn,
.sidebar.collapsed .chat-item-pin{display:none;}

/* Collapse chevron rotation — toggled by sidebar.js */
.icon-btn.rotated{transform:rotate(180deg);}

.sidebar-inner{width:var(--sidebar-w); height:100%; display:flex; flex-direction:column; padding:14px 12px;}

.sidebar-header{display:flex; align-items:center; justify-content:space-between; padding:4px 6px 14px;}
.brand{display:flex; align-items:center; gap:9px;}
.brand-name{font-family:var(--font-display); font-weight:700; font-size:17px; letter-spacing:-.02em;}

/* New chat — monochrome ink action */
.new-chat-btn{
  display:flex; align-items:center; gap:10px; width:100%; padding:10px 12px;
  background:var(--text-primary); color:var(--bg-surface); border:none; border-radius:var(--radius-md);
  font-weight:600; font-size:14px; margin-bottom:12px;
  transition:opacity var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
  box-shadow:var(--shadow-1);
}
.new-chat-btn:hover{opacity:.88;}
.new-chat-btn:active{transform:scale(.98);}
.new-chat-btn .kbd-hint{margin-left:auto; background:rgba(128,128,128,.22); border:none; color:inherit;}

.sidebar-search{
  display:flex; align-items:center; gap:8px; background:var(--bg-elevated);
  border:1px solid var(--border-soft); border-radius:var(--radius-md); padding:9px 12px; margin-bottom:12px;
  transition:border-color var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
}
.sidebar-search:focus-within{border-color:var(--accent); box-shadow:0 0 0 2px rgba(var(--accent-rgb),.1);}
.sidebar-search i{color:var(--text-tertiary); font-size:13px;}
.sidebar-search input{background:transparent; border:none; outline:none; width:100%; font-size:13.5px; color:var(--text-primary);}
.sidebar-search input::placeholder{color:var(--text-tertiary);}

.chat-history{flex:1; overflow-y:auto; display:flex; flex-direction:column; gap:2px; margin:0 -4px; padding:0 4px;}
.chat-history-label{
  font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.06em;
  color:var(--text-tertiary); padding:14px 8px 6px;
}
.chat-history-label:first-child{padding-top:4px;}
.chat-item{
  display:flex; align-items:center; gap:9px; padding:9px 10px; border-radius:var(--radius-sm);
  color:var(--text-secondary); font-size:13.5px; position:relative; overflow:hidden;
  transition:background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.chat-item i.chat-icon{font-size:12px; color:var(--text-tertiary); flex:0 0 auto;}
.chat-item span{white-space:nowrap; overflow:hidden; text-overflow:ellipsis; flex:1;}
.chat-item:hover{background:var(--bg-hover); color:var(--text-primary); cursor:pointer;}
.chat-item.active{background:var(--surface-sunken); color:var(--text-primary); font-weight:500;}
.chat-item.active::before{
  content:''; position:absolute; left:0; top:8px; bottom:8px; width:3px; border-radius:3px; background:var(--accent);
}
.chat-item.active i.chat-icon{color:var(--text-primary);}
.no-results{padding:20px 10px; text-align:center; color:var(--text-tertiary); font-size:13px;}

.sidebar-footer{border-top:1px solid var(--border-soft); padding-top:10px; margin-top:8px;}
.sidebar-footer-btn{
  display:flex; align-items:center; gap:10px; width:100%; padding:9px 10px; background:transparent;
  border:none; border-radius:var(--radius-sm); color:var(--text-secondary); font-size:13.5px;
  transition:background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.sidebar-footer-btn:hover{background:var(--bg-hover); color:var(--text-primary);}

.profile-section{
  display:flex; align-items:center; gap:10px; padding:9px 8px; border-radius:var(--radius-sm);
  margin-top:4px; cursor:pointer; transition:background var(--dur-fast) var(--ease);
}
.profile-section:hover{background:var(--bg-hover);}
.profile-avatar{
  width:30px; height:30px; border-radius:50%; background:var(--text-primary); color:var(--bg-surface);
  display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700; flex:0 0 auto;
}
.profile-meta{display:flex; flex-direction:column; min-width:0; flex:1;}
.profile-name{font-size:13.5px; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
.profile-plan{font-size:11.5px; color:var(--text-tertiary); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
.profile-section > i{color:var(--text-tertiary); font-size:13px;}

/* ===== Profile Popup ===== */
.profile-popup{position:fixed; z-index:20000; width:260px; display:none;}
.profile-popup.show{display:block;}
.profile-popup-card{
  background:var(--bg-elevated); border-radius:var(--radius-md); border:1px solid var(--border);
  width:260px; padding:20px; box-shadow:var(--shadow-3);
}
.profile-popup-header{display:flex; align-items:center; gap:12px; margin-bottom:16px;}
.profile-popup-header .profile-avatar{width:40px; height:40px; font-size:16px;}
.profile-popup-name{font-size:15px; font-weight:600; color:var(--text-primary);}
.profile-popup-email{font-size:12px; color:var(--text-tertiary);}
.profile-popup-item{
  display:flex; align-items:center; gap:12px; padding:12px; background:transparent; border:none;
  width:100%; text-align:left; font-size:14px; color:var(--text-primary); cursor:pointer;
  border-radius:var(--radius-sm); margin:2px 0; transition:background var(--dur-fast) var(--ease);
}
.profile-popup-item:hover{background:var(--bg-hover);}
.profile-popup-item i{width:18px; text-align:center; color:var(--text-tertiary); font-size:15px;}
.profile-popup-item.logout-btn{color:var(--danger); font-weight:600;}
.profile-popup-item.logout-btn:hover{background:var(--danger-soft);}
.profile-popup-item.logout-btn i{color:var(--danger);}
.profile-popup-divider{height:1px; background:var(--border-soft); margin:8px 0;}

.sidebar-scrim{
  position:fixed; inset:0; background:rgba(10,10,12,.5); z-index:45;
  opacity:0; visibility:hidden; pointer-events:none;
  transition:opacity var(--dur-fast) var(--ease), visibility var(--dur-fast) var(--ease);
}
.sidebar-scrim.show{opacity:1; visibility:visible; pointer-events:auto;}

/* ---------- Main panel ---------- */
.main-panel{flex:1; display:flex; flex-direction:column; min-width:0; position:relative;}

/* Topbar — solid surface, no heavy glass */
.topbar{
  display:flex; align-items:center; gap:8px; padding:8px 16px;
  background:var(--surface-panel); border-bottom:1px solid var(--border-soft); position:relative; z-index:20;
}
.expand-btn{margin-right:2px;}

/* Model selector — refined command control (not a pill) */
.model-selector{position:relative;}
.model-selector-btn{
  display:flex; align-items:center; gap:7px; padding:6px 12px 6px 9px; background:var(--bg-elevated);
  border:1px solid var(--border); border-radius:var(--radius-sm); font-size:12.5px; color:var(--text-primary);
  transition:background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
}
.model-selector-btn:hover{background:var(--bg-hover); border-color:var(--border-strong);}
.model-selector.open .model-selector-btn{border-color:var(--accent); box-shadow:0 0 0 3px rgba(var(--accent-rgb),.12);}
.provider-dot{width:7px; height:7px; border-radius:50%; background:var(--dot-color); flex:0 0 auto;}
.model-name{font-weight:600; font-size:12.5px;}
.model-provider{color:var(--text-tertiary); font-size:10.5px;}
.model-selector-btn i.fa-chevron-down{font-size:9px; color:var(--text-tertiary); margin-left:3px; transition:transform var(--dur-fast) var(--ease);}
.model-selector.open .model-selector-btn i.fa-chevron-down{transform:rotate(180deg);}

.model-selector-btn .status-dot{width:7px; height:7px; border-radius:50%; margin-left:6px; flex:0 0 auto;}
.model-selector-btn .status-dot.online{background:var(--success);}
.model-selector-btn .status-dot.local{background:var(--warning);}
.model-selector-btn .status-dot.offline{background:var(--text-tertiary);}

.model-selector-btn .reasoning-effort{
  display:inline-flex; align-items:center; gap:3px; margin-left:4px;
  font-size:10px; font-weight:600; color:var(--accent);
  padding:1px 6px; border-radius:999px;
  background:rgba(var(--accent-rgb),.12); border:1px solid rgba(var(--accent-rgb),.25);
}
.model-selector-btn .reasoning-effort i{font-size:9px; opacity:.85;}
.model-selector-btn .reasoning-effort.hidden{display:none;}

.model-dropdown{
  position:absolute; top:calc(100% + 10px); left:50%; transform:translateX(-50%) translateY(-6px);
  width:380px; max-height:440px;
  background:var(--bg-elevated); border:1px solid var(--border); border-radius:var(--radius-md);
  box-shadow:var(--shadow-3); opacity:0; visibility:hidden;
  transition:opacity var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease), visibility var(--dur-fast);
  display:flex; flex-direction:column; z-index:30;
}
.model-selector.open .model-dropdown{opacity:1; visibility:visible; transform:translateX(-50%) translateY(0);}
.model-dropdown-search{
  display:flex; align-items:center; gap:8px; padding:10px 14px; border-bottom:1px solid var(--border);
  background:var(--bg-surface);
}
.model-dropdown-search i{color:var(--text-tertiary); font-size:13px;}
.model-dropdown-search input{background:transparent; border:none; outline:none; width:100%; font-size:13.5px; color:var(--text-primary);}
.model-dropdown-search input::placeholder{color:var(--text-tertiary);}
.search-clear{background:transparent; border:none; color:var(--text-tertiary); padding:2px 6px; border-radius:4px; cursor:pointer; font-size:13px; transition:color var(--dur-fast) var(--ease);}
.search-clear:hover{color:var(--text-primary);}
.model-list{overflow-y:auto; padding:6px; scrollbar-width:thin; scrollbar-color:var(--border) transparent;}
.model-list::-webkit-scrollbar{width:5px;}
.model-list::-webkit-scrollbar-thumb{background:var(--border); border-radius:4px;}
.model-provider-filters{display:flex;gap:5px;overflow-x:auto;padding:8px 14px;border-bottom:1px solid var(--border);scrollbar-width:none;}
.model-provider-filters::-webkit-scrollbar{display:none;}
.model-provider-filters button{border:1px solid var(--border-soft);background:transparent;color:var(--text-secondary);border-radius:999px;padding:4px 10px;font-size:11px;white-space:nowrap;cursor:pointer;transition:all var(--dur-fast) var(--ease);flex:0 0 auto;}
.model-provider-filters button:hover{background:var(--bg-hover);border-color:var(--accent);color:var(--text-primary);}
.model-provider-filters button.active{background:var(--accent);border-color:var(--accent);color:var(--on-accent);}
.model-group-label{font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--text-tertiary); padding:12px 10px 5px;}
.model-option{
  display:flex; align-items:center; gap:10px; width:100%; padding:8px 10px; border-radius:var(--radius-sm);
  color:var(--text-primary); font-size:13px; text-align:left; cursor:pointer;
  margin-bottom:1px; border:none; background:transparent;
  transition:background var(--dur-fast) var(--ease);
}
.model-option:hover{background:var(--bg-hover);}
.model-option.selected{background:rgba(var(--accent-rgb),.08);}
.model-option.selected:hover{background:rgba(var(--accent-rgb),.12);}
.model-option .provider-dot{width:8px; height:8px; border-radius:50%; background:var(--dot-color); flex:0 0 auto;}
.model-option .model-option-meta{display:flex; flex-direction:column; min-width:0;}
.model-option .model-option-name{font-size:13px; font-weight:600; color:var(--text-primary); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
.model-option .model-option-meta small{color:var(--text-tertiary); font-size:11px;}
.model-option .model-option-meta small code{font-family:var(--font-mono); font-size:10px; background:var(--bg-elevated-2); padding:1px 4px; border-radius:4px; color:var(--text-secondary);}
.model-option .status-dot{width:6px; height:6px; border-radius:50%; margin-left:auto; flex:0 0 auto;}
.status-dot.online{background:var(--success);}
.status-dot.local{background:var(--warning);}
.status-dot.offline{background:var(--text-tertiary);}

.model-option .model-option-context{
  font-size:10px; color:var(--text-tertiary); margin-left:auto; white-space:nowrap;
  background:var(--bg-elevated-2); padding:1px 6px; border-radius:4px;
  font-weight:500; margin-right:6px;
}
.model-option .model-option-speed{display:inline-block; width:6px; height:6px; border-radius:50%; flex:0 0 auto;}
.model-option-speed.fast{background:var(--success);}
.model-option-speed.medium{background:var(--warning);}
.model-option-speed.slow{background:var(--danger);}

.topbar-right{margin-left:auto; display:flex; align-items:center; gap:6px;}
.topbar .icon-btn{width:32px; height:32px; font-size:13px;}
.conn-pulse{
  display:flex; align-items:center; gap:6px; font-size:11.5px; color:var(--text-secondary);
  background:var(--bg-elevated); border:1px solid var(--border-soft); padding:5px 11px; border-radius:999px;
  height:32px; box-sizing:border-box;
}
.pulse-dot{width:7px; height:7px; border-radius:50%; background:var(--success); position:relative;}
.pulse-dot::after{
  content:''; position:absolute; inset:-4px; border-radius:50%; background:var(--success); opacity:.5;
  animation:pulseRing 2s var(--ease) infinite;
}
@keyframes pulseRing{0%{transform:scale(.6); opacity:.6;} 100%{transform:scale(1.8); opacity:0;}}

/* ---------- Chat scroll / column ---------- */
.chat-scroll{flex:1; overflow-y:auto; position:relative;}
.chat-column{max-width:var(--chat-max-w); margin:0 auto; padding:28px 24px 12px;}

/* Welcome screen — refined, content-first */
.welcome-screen{
  display:flex; flex-direction:column; align-items:center; text-align:center; padding:9vh 10px 5vh;
  animation:fadeUp var(--dur-med) var(--ease);
}
.welcome-mark{
  display:flex; align-items:center; justify-content:center;
  margin-bottom:22px;
}
.welcome-screen h1{font-size:calc(28px * var(--font-scale)); font-weight:700; letter-spacing:-.02em; margin-bottom:10px; color:var(--text-primary);}
.welcome-sub{color:var(--text-secondary); font-size:calc(15px * var(--font-scale)); max-width:460px; margin-bottom:28px; line-height:1.6;}
.welcome-keyhints{font-size:11px; color:var(--text-tertiary); margin-top:24px; display:flex; gap:8px; flex-wrap:wrap; justify-content:center;}
.welcome-keyhints kbd{font-size:10px; padding:1px 5px;}

/* Onboarding hint */
.onboarding-hint{width:100%; max-width:620px; margin-bottom:16px; animation:fadeUp var(--dur-med) var(--ease);}
.onboarding-card{display:flex; align-items:flex-start; gap:14px; padding:16px; background:var(--bg-elevated); border:1px solid var(--border); border-radius:var(--radius-md); text-align:left; box-shadow:var(--shadow-1);}
.onboarding-card i{font-size:20px; color:var(--accent); flex:0 0 auto; margin-top:2px;}
.onboarding-card strong{display:block; font-size:14px; margin-bottom:4px;}
.onboarding-card p{font-size:12.5px; color:var(--text-secondary); margin-bottom:10px;}
.onboarding-card .btn-secondary{font-size:12px; padding:6px 12px;}

.suggestion-grid{display:grid; grid-template-columns:1fr 1fr; grid-auto-rows:1fr; gap:10px; width:100%; max-width:620px;}
.suggestion-card{
  display:flex; align-items:center; gap:11px; padding:14px 16px; text-align:left; min-width:0;
  background:var(--surface-panel); border:1px solid var(--border-soft); border-radius:var(--radius-md);
  font-size:calc(13.5px * var(--font-scale)); color:var(--text-primary);
  transition:border-color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
}
.suggestion-card i{color:var(--accent); font-size:15px; flex:0 0 auto; width:32px; height:32px; border-radius:8px; background:rgba(var(--accent-rgb),.1); display:flex; align-items:center; justify-content:center; transition:background var(--dur-fast) var(--ease);}
.suggestion-card:hover{border-color:var(--border-strong); transform:translateY(-1px); background:var(--bg-elevated); box-shadow:var(--shadow-1);}
.suggestion-card:hover i{background:rgba(var(--accent-rgb),.18);}
.suggestion-card:active{transform:translateY(0) scale(.98); box-shadow:none;}

/* ---------- Messages ---------- */
.messages{display:flex; flex-direction:column; gap:24px; padding-bottom:20px;}
.msg{display:flex; gap:14px; animation:fadeUp var(--dur-med) var(--ease);}
@keyframes fadeUp{from{opacity:0; transform:translateY(8px);} to{opacity:1; transform:translateY(0);}}

/* User messages: right-aligned, compact monochrome surface */
.msg.user{flex-direction:row-reverse;}
.msg.user .msg-body{align-items:flex-end;}

/* Assistant messages: document-style, full-width block */
.msg.assistant{display:block;}

/* Streaming avatar is redundant with the document look — hide it */
.msg.assistant > .msg-avatar{display:none;}

.msg-avatar{
  width:30px; height:30px; border-radius:9px; flex:0 0 auto; display:flex; align-items:center; justify-content:center;
  font-size:13px; margin-top:2px;
}
.msg.user .msg-avatar{background:var(--bg-elevated-2); color:var(--text-secondary);}

.msg-body{display:flex; flex-direction:column; flex:1; min-width:0;}
.msg-meta{display:flex; align-items:baseline; gap:8px; margin-bottom:5px; flex-wrap:wrap;}
.msg-author{font-size:13px; font-weight:600; letter-spacing:-.01em;}
.msg-time{font-size:11px; color:var(--text-tertiary);}
.msg-provider-tag{font-size:11px; color:var(--text-tertiary); font-weight:600; padding:1px 7px; border-radius:999px; background:color-mix(in srgb, var(--provider-color, var(--accent)) 14%, transparent); border:1px solid color-mix(in srgb, var(--provider-color, var(--accent)) 32%, transparent);}
.msg-response-time{font-size:11px; color:var(--text-tertiary); margin-left:auto; white-space:nowrap;}

.msg-content{
  font-size:calc(14.5px * var(--font-scale)); line-height:1.7; color:var(--text-primary); position:relative;
  overflow-wrap:break-word; word-wrap:break-word; word-break:break-word;
}
.msg.user .msg-content{
  background:var(--user-bubble); border:1px solid var(--border-soft); padding:11px 16px;
  border-radius:var(--radius-md); border-top-right-radius:6px;
  display:inline-block; max-width:100%;
}

/** ---------- Markdown content (scoped to .assistant-response for semantic isolation) ---------- **/
.assistant-response p { margin: 0 0 12px; line-height: 1.7; }
.assistant-response p:last-child { margin-bottom: 0; }
.assistant-response p + h1,
.assistant-response p + h2,
.assistant-response p + h3,
.assistant-response p + h4,
.assistant-response p + h5,
.assistant-response p + h6 { margin-top: 22px; }

.assistant-response ul, .assistant-response ol { margin: 0 0 12px; padding-left: 24px; }
.assistant-response li { margin-bottom: 5px; line-height: 1.65; }
.assistant-response li > p { margin: 0; }
.assistant-response li > p:not(:last-child) { margin-bottom: 4px; }
.assistant-response ul ul,
.assistant-response ol ol,
.assistant-response ul ol,
.assistant-response ol ul { margin-top: 6px; margin-bottom: 6px; padding-left: 20px; }
.assistant-response li::marker { color: var(--text-tertiary); }

.assistant-response h1, .assistant-response h2, .assistant-response h3,
.assistant-response h4, .assistant-response h5, .assistant-response h6 {
  margin: 22px 0 10px; font-family: var(--font-display); color: var(--text-primary);
  line-height: 1.35; font-weight: 600; letter-spacing: -.015em;
}
.assistant-response h1 { font-size: 1.4em; padding-bottom: 8px; border-bottom: 1px solid var(--border); font-weight: 700; }
.assistant-response h2 { font-size: 1.25em; font-weight: 700; }
.assistant-response h3 { font-size: 1.12em; }
.assistant-response h4 { font-size: 1em; }
.assistant-response h5 { font-size: .95em; }
.assistant-response h6 { font-size: .9em; color: var(--text-secondary); }

.assistant-response strong { font-weight: 600; }
.assistant-response em { font-style: italic; }
.assistant-response del { text-decoration: line-through; color: var(--text-secondary); }

.assistant-response a {
  color: var(--accent); text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
}
.assistant-response a:hover { color: var(--accent-soft); border-bottom-color: var(--accent); }
.assistant-response a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px; }

.assistant-response blockquote {
  margin: 14px 0; padding: 10px 16px; border-left: 3px solid var(--quote-border, var(--border-strong));
  background: var(--bg-elevated-2); border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  color: var(--text-secondary);
}
.assistant-response blockquote p { margin: 6px 0; }
.assistant-response blockquote p:first-child { margin-top: 0; }
.assistant-response blockquote p:last-child { margin-bottom: 0; }
.assistant-response blockquote > *:last-child { margin-bottom: 0; }

.assistant-response hr {
  border: none; border-top: 1px solid var(--border);
  margin: 18px 0; opacity: .7;
}

.assistant-response code:not(pre code) {
  font-family: var(--font-mono); background: var(--bg-elevated-2);
  padding: 2px 6px; border-radius: 5px; font-size: .87em;
  color: var(--text-primary); border: 1px solid var(--border-soft);
}

/** ---------- Tables — real tables, correctly ---------- **/
.assistant-response .table-scroll {
  overflow-x: auto; -webkit-overflow-scrolling: touch;
  margin: 14px 0; border: 1px solid var(--border); border-radius: var(--radius-sm);
}
.assistant-response table {
  border-collapse: collapse; width: 100%; font-size: 13px; line-height: 1.55;
  border-spacing: 0;
}
.assistant-response .table-scroll table { min-width: 100%; }
.assistant-response th, .assistant-response td {
  padding: 9px 13px; text-align: left; border-bottom: 1px solid var(--border-soft);
  vertical-align: top;
}
.assistant-response thead th {
  background: var(--bg-elevated-2); font-weight: 600; font-size: 12px;
  color: var(--text-secondary); text-transform: uppercase; letter-spacing: .03em;
  border-bottom: 1px solid var(--border);
}
.assistant-response tbody tr:nth-child(even) { background: rgba(var(--accent-rgb), .025); }
.assistant-response tbody tr:hover { background: rgba(var(--accent-rgb), .05); }
.assistant-response tbody tr:last-child td { border-bottom: none; }

/* Task lists */
.assistant-response .task-list-item { display: flex; align-items: flex-start; gap: 8px; }
.assistant-response .task-list-item input[type="checkbox"] {
  flex: 0 0 auto; margin-top: 3px; accent-color: var(--accent);
}

/* Images */
.assistant-response img {
  max-width: 100%; height: auto; border-radius: var(--radius-sm);
  margin: 8px 0; border: 1px solid var(--border-soft);
}
.assistant-response pre { overflow-x: auto; max-width: 100%; }

/** ---------- Typography Refinements (§7-8) ---------- **/

/* Fluid type scale for .assistant-response container */
.assistant-response {
  /* Base fluid size: 14.5px clamps to 13px-16px across 320px-1920px viewport */
  font-size: clamp(13px, 14.5px + 0.25vw, 16px);
  line-height: 1.7;
  color: var(--text-primary);
}

/* Heading hierarchy with anchor link support */
.assistant-response h1,
.assistant-response h2,
.assistant-response h3,
.assistant-response h4,
.assistant-response h5,
.assistant-response h6 {
  position: relative;
  margin: 22px 0 10px;
  font-family: var(--font-display);
  color: var(--text-primary);
  line-height: 1.35;
  font-weight: 600;
  letter-spacing: -.015em;
}

/* Anchor links on headings - visible on hover/focus */
.assistant-response h1::before,
.assistant-response h2::before,
.assistant-response h3::before,
.assistant-response h4::before,
.assistant-response h5::before,
.assistant-response h6::before {
  content: '#';
  position: absolute;
  left: -24px;
  top: 0;
  opacity: 0;
  font-size: 0.85em;
  font-weight: 400;
  color: var(--text-tertiary);
  transition: opacity var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  text-decoration: none;
}
.assistant-response h1:hover::before,
.assistant-response h2:hover::before,
.assistant-response h3:hover::before,
.assistant-response h4:hover::before,
.assistant-response h5:hover::before,
.assistant-response h6:hover::before,
.assistant-response h1:focus-within::before,
.assistant-response h2:focus-within::before,
.assistant-response h3:focus-within::before,
.assistant-response h4:focus-within::before,
.assistant-response h5:focus-within::before,
.assistant-response h6:focus-within::before {
  opacity: 0.6;
}
.assistant-response h1:hover::before:hover,
.assistant-response h2:hover::before:hover,
.assistant-response h3:hover::before:hover,
.assistant-response h4:hover::before:hover,
.assistant-response h5:hover::before:hover,
.assistant-response h6:hover::before:hover,
.assistant-response h1:focus-within::before:focus,
.assistant-response h2:focus-within::before:focus,
.assistant-response h3:focus-within::before:focus,
.assistant-response h4:focus-within::before:focus,
.assistant-response h5:focus-within::before:focus,
.assistant-response h6:focus-within::before:focus {
  opacity: 1;
  color: var(--accent);
}

.assistant-response h1 { font-size: clamp(1.75rem, 1.6rem + 1.5vw, 2.5rem); padding-bottom: 8px; border-bottom: 1px solid var(--border); font-weight: 700; }
.assistant-response h2 { font-size: clamp(1.5rem, 1.35rem + 1vw, 2rem); font-weight: 700; }
.assistant-response h3 { font-size: clamp(1.25rem, 1.15rem + 0.75vw, 1.5rem); }
.assistant-response h4 { font-size: clamp(1.1rem, 1.05rem + 0.5vw, 1.25rem); }
.assistant-response h5 { font-size: clamp(1rem, 0.98rem + 0.25vw, 1.1rem); }
.assistant-response h6 { font-size: clamp(0.95rem, 0.93rem + 0.1vw, 1rem); color: var(--text-secondary); }

/* Page margin for first/last heading */
.assistant-response > h1:first-child,
.assistant-response > h2:first-child,
.assistant-response > h3:first-child { margin-top: 0; }
.assistant-response > *:last-child { margin-bottom: 0; }

/* Paragraph spacing refinements */
.assistant-response p { margin: 0 0 14px; }
.assistant-response p:last-child { margin-bottom: 0; }
.assistant-response p + h1, .assistant-response p + h2, .assistant-response p + h3,
.assistant-response p + h4, .assistant-response p + h5, .assistant-response p + h6 { margin-top: 24px; }

/* List polish - tight mode for compact lists, sparse for readable ones */
.assistant-response ul,
.assistant-response ol {
  margin: 0 0 14px;
  padding-left: 24px;
}
.assistant-response li {
  margin-bottom: 6px;
  line-height: 1.65;
}
.assistant-response li > p { margin: 0; }
.assistant-response li > p:not(:last-child) { margin-bottom: 4px; }

/* Nested lists - alternate bullet styles */
.assistant-response ul ul,
.assistant-response ol ol,
.assistant-response ul ol,
.assistant-response ol ul {
  margin-top: 6px;
  margin-bottom: 6px;
  padding-left: 20px;
}
.assistant-response ul ul { list-style-type: circle; }
.assistant-response ul ul ul { list-style-type: square; }
.assistant-response ol ol { list-style-type: lower-alpha; }
.assistant-response ol ol ol { list-style-type: lower-roman; }
.assistant-response li::marker { color: var(--text-tertiary); }

/* start attribute support for ordered lists */
.assistant-response ol[start] { counter-reset: list-counter calc(var(--start, 1) - 1); }
.assistant-response ol[start] > li { counter-increment: list-counter; }
.assistant-response ol[start] > li::marker { content: counter(list-counter) '.'; }

/* Blockquote styling - refined with nested support */
.assistant-response blockquote {
  margin: 16px 0;
  padding: 12px 18px;
  border-left: 3px solid var(--quote-border, var(--border-strong));
  background: var(--bg-elevated-2);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  color: var(--text-secondary);
  font-style: italic;
}
.assistant-response blockquote p { margin: 6px 0; }
.assistant-response blockquote p:first-child { margin-top: 0; }
.assistant-response blockquote p:last-child { margin-bottom: 0; }
.assistant-response blockquote > *:last-child { margin-bottom: 0; }

/* Nested blockquotes */
.assistant-response blockquote blockquote {
  margin: 10px 0 10px -18px;
  padding-left: 18px;
  border-left-color: var(--accent);
  background: transparent;
  border-radius: 0;
}
.assistant-response blockquote blockquote::before {
  content: '';
  position: absolute;
  left: -21px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: var(--border-soft);
  border-radius: 1px;
}

/* Inline code refinements */
.assistant-response code:not(pre code) {
  font-family: var(--font-mono);
  background: var(--bg-elevated-3, var(--bg-elevated-2));
  padding: 2px 7px;
  border-radius: 5px;
  font-size: 0.87em;
  color: var(--text-primary);
  border: 1px solid var(--border-soft);
  line-height: 1.4;
}

/* Link behavior enhancements */
.assistant-response a {
  color: var(--accent);
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  position: relative;
}
.assistant-response a:hover {
  color: var(--accent-soft);
  border-bottom-color: var(--accent);
}
.assistant-response a:focus-visible {
  outline: 2px solid var(--focus-ring);
  outline-offset: 2px;
  border-radius: 2px;
  border-bottom-color: transparent;
}

/* External link indicator */
.assistant-response a[href^="http"]:not([href*="localhost"]):not([href*="127.0.0.1"]):after {
  content: '\00a0\29C9';  /* ⧉ */
  font-size: 0.7em;
  opacity: 0.5;
  margin-left: 2px;
  vertical-align: super;
  transition: opacity var(--dur-fast) var(--ease);
}
.assistant-response a[href^="http"]:not([href*="localhost"]):not([href*="127.0.0.1"]):hover:after {
  opacity: 1;
}

/* HR refinement */
.assistant-response hr {
  border: none;
  border-top: 1px solid var(--border);
  margin: 20px 0;
  opacity: .7;
}

/* Code block wrapper refinements */
.assistant-response pre:has(code) {
  margin: 0; /* Handled by .code-block wrapper */
}

/* Ensure minimum touch targets for interactive elements */
.assistant-response button,
.assistant-response a,
.assistant-response input[type="checkbox"] {
  min-height: 44px;
  min-width: 44px;
}

/* Responsive table container */
.assistant-response .table-scroll {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  margin: 14px 0;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
}

/* ---------- Code blocks ---------- */
.code-block{
  margin:14px 0; border-radius:var(--radius-sm); overflow:hidden; border:1px solid var(--border);
  background:var(--code-block-bg);
  transition:border-color var(--dur-fast) var(--ease);
}
.code-block:hover{border-color:var(--code-block-border-hover);}
.code-block-header{
  display:flex; align-items:center; justify-content:space-between; padding:6px 12px;
  background:var(--code-block-header-bg);
  border-bottom:1px solid var(--code-block-header-border);
  font-family:var(--font-mono); font-size:11px; font-weight:600; color:var(--text-tertiary);
  text-transform:uppercase; letter-spacing:.04em;
}
.code-block-header span{display:flex;align-items:center;gap:6px;}
.code-block-header span::before{content:'</>';font-size:10px;opacity:.6;}

/* Filename display in code block header */
.code-filename {
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 500;
  color: var(--text-secondary);
  background: var(--bg-surface);
  padding: 2px 8px;
  border-radius: 4px;
  border: 1px solid var(--border-soft);
  text-transform: none;
  letter-spacing: 0;
}
.code-filename::before { content: ''; }

.copy-code-btn{
  display:inline-flex; align-items:center; gap:4px;
  background:transparent; border:1px solid var(--border); border-radius:5px;
  padding:3px 8px; font-size:10.5px; font-weight:500; color:var(--text-tertiary);
  font-family:var(--font-body);
  transition:background 150ms ease, color 150ms ease, border-color 150ms ease;
  min-height: 32px;  /* touch target */
}
.copy-code-btn:hover{background:var(--code-block-btn-hover-bg); color:var(--text-primary); border-color:var(--text-tertiary);}
.copy-code-btn.copied{color:var(--success); border-color:var(--success);}
.code-block pre{margin:0; overflow-x:auto;}
.code-block pre code{display:block; padding:14px 16px; font-size:13px; line-height:1.6;}
.code-block code{font-family:var(--font-mono);}

/* Line highlighting support */
.code-block.has-line-highlights pre code {
  /* We'll use a pseudo-element approach for highlighting specific lines */
  counter-reset: line;
}
.code-block.has-line-highlights pre code .hljs-ln:before,
.code-block.has-line-highlights pre code .hljs-ln-code:before {
  counter-increment: line;
  content: counter(line);
  display: inline-block;
  width: 2.5rem;
  text-align: right;
  margin-right: 1rem;
  color: var(--text-tertiary);
  opacity: 0.6;
  user-select: none;
  pointer-events: none;
}

/* Highlighted lines - using CSS custom property for line numbers */
.code-block.has-line-highlights pre code .hljs-ln.highlighted {
  background: rgba(var(--accent-rgb), 0.1);
  border-left: 2px solid var(--accent);
  margin-left: -2px;
  padding-left: 14px; /* compensate for border */
}

/* Force hljs background transparent so .code-block bg shows through */
.code-block code.hljs{background:transparent;}
.code-block .hljs,
.code-block .hljs-strong,
.code-block .hljs-emphasis,
.code-block .hljs-bullet,
.code-block .hljs-code,
.code-block .hljs-formula{color:var(--hljs-color);}
.code-block .hljs-keyword,
.code-block .hljs-selector-tag,
.code-block .hljs-selector-class,
.code-block .hljs-selector-id,
.code-block .hljs-selector-attr,
.code-block .hljs-selector-pseudo,
.code-block .hljs-doctag{color:var(--hljs-keyword);}
.code-block .hljs-string,
.code-block .hljs-regexp,
.code-block .hljs-addition,
.code-block .hljs-attribute,
.code-block .hljs-meta-string{color:var(--hljs-string);}
.code-block .hljs-number,
.code-block .hljs-literal{color:var(--hljs-number);}
.code-block .hljs-comment,
.code-block .hljs-quote,
.code-block .hljs-deletion,
.code-block .hljs-meta{color:var(--hljs-comment);}
.code-block .hljs-title,
.code-block .hljs-section,
.code-block .hljs-symbol,
.code-block .hljs-built_in{color:var(--hljs-title);}
.code-block .hljs-type{color:var(--hljs-type);}
.code-block .hljs-attr{color:var(--hljs-attr);}
.code-block .hljs-variable,
.code-block .hljs-template-variable,
.code-block .hljs-link{color:var(--hljs-variable);}

/* ---------- Message actions ---------- */
.msg-actions{display:flex; align-items:center; gap:2px; margin-top:10px; opacity:0; transition:opacity 150ms ease;}
.msg:hover .msg-actions,
.msg.assistant .msg-actions:focus-within{opacity:1;}
.msg-actions.always-visible{opacity:1;}
.msg-action-btn{
  display:flex; align-items:center; gap:6px; padding:5px 9px; background:transparent; border:none;
  border-radius:var(--radius-sm); color:var(--text-tertiary); font-size:12px;
  transition:background 150ms ease, color 150ms ease;
}
.msg-action-btn:hover{background:var(--bg-hover); color:var(--text-primary);}
.msg-action-btn.copied{color:var(--success);}

/* User message edit */
.msg.user .msg-edit-btn{
  display:inline-flex; align-items:center; gap:5px;
  padding:4px 10px; border-radius:6px; font-size:12px;
  background:var(--bg-elevated-2); border:1px solid var(--border);
  color:var(--text-secondary); cursor:pointer; margin-top:6px;
  opacity:0; transition:background 150ms ease, color 150ms ease, opacity 150ms ease;
}
.msg.user:hover .msg-edit-btn{opacity:1;}
.msg.user .msg-edit-btn:hover{background:var(--bg-hover); color:var(--text-primary);}
.msg.user .msg-edit-textarea{
  width:100%; resize:none; background:var(--bg-elevated); border:1px solid var(--border);
  border-radius:var(--radius-sm); padding:10px 12px; font-size:14px; color:var(--text-primary);
  font-family:var(--font-body); line-height:1.5; min-height:80px; box-sizing:border-box; margin-top:6px;
}
.msg.user .msg-edit-textarea:focus{outline:none; border-color:var(--accent); box-shadow:0 0 0 3px rgba(var(--accent-rgb),.12);}
.msg.user .msg-edit-actions{display:flex; gap:6px; margin-top:8px;}
.msg.user .msg-edit-actions button{padding:6px 14px; border-radius:6px; font-size:12.5px; font-weight:500; cursor:pointer; transition:background 150ms ease;}
.msg.user .msg-edit-save{background:var(--accent); color:var(--on-accent); border:none;}
.msg.user .msg-edit-save:hover{filter:brightness(1.1);}
.msg.user .msg-edit-cancel{background:transparent; border:1px solid var(--border); color:var(--text-secondary);}
.msg.user .msg-edit-cancel:hover{background:var(--bg-hover); color:var(--text-primary);}

/* Timestamps: hidden by default, visible on hover */
.msg .msg-time{opacity:0; transition:opacity 150ms ease;}
.msg:hover .msg-time{opacity:.85;}

/* ---------- Typing / streaming / phase ---------- */
.typing-indicator{display:flex; align-items:center; gap:4px; padding:6px 0;}
.typing-indicator span{
  width:6px; height:6px; border-radius:50%; background:var(--text-tertiary);
  animation:typingBounce 1.2s var(--ease) infinite;
}
.typing-indicator span:nth-child(2){animation-delay:.15s;}
.typing-indicator span:nth-child(3){animation-delay:.3s;}
@keyframes typingBounce{0%,60%,100%{transform:translateY(0); opacity:.5;} 30%{transform:translateY(-4px); opacity:1;}}

.stream-cursor{display:inline-block; width:2px; height:1.1em; background:var(--accent); margin-left:1px; vertical-align:text-bottom; animation:blink .8s step-end infinite; border-radius:1px;}
@keyframes blink{50%{opacity:0;}}

.msg-phase-status{
  display:inline-flex; align-items:center; gap:6px;
  font-size:11.5px; font-weight:500; color:var(--text-secondary);
  padding:2px 0 4px;
}
.msg-phase-status i{font-size:10px; color:var(--accent);}
.msg-phase-status.connecting i{animation:phasePulse 1.2s var(--ease) infinite;}
.msg-phase-status.thinking i{animation:thinkBrain 1.2s var(--ease) infinite;}
.msg-phase-status.writing i{animation:none;}
@keyframes phasePulse{0%,100%{opacity:.5; transform:scale(1);} 50%{opacity:1; transform:scale(1.1);}}

.msg-thinking-elapsed{font-size:10px; color:var(--text-tertiary); font-weight:500; margin-left:4px;}

/* Reasoning section */
.msg-reasoning{margin:0 0 12px;}
.msg-reasoning details{
  background:var(--reasoning-soft); border:1px solid color-mix(in srgb, var(--reasoning) 28%, transparent);
  border-left:3px solid var(--reasoning);
  border-radius:var(--radius-sm); padding:8px 12px; font-size:12.5px;
  transition:background var(--dur-fast) var(--ease);
}
.msg-reasoning details:hover{background:color-mix(in srgb, var(--reasoning-soft) 60%, var(--bg-elevated));}
.msg-reasoning summary{
  cursor:pointer; font-weight:600; color:var(--text-secondary);
  font-size:11px; text-transform:uppercase; letter-spacing:.03em;
  user-select:none; display:flex; align-items:center; gap:6px;
  transition:color var(--dur-fast) var(--ease);
}
.msg-reasoning details[open] summary{color:var(--reasoning); margin-bottom:6px;}
.msg-reasoning summary i{font-size:12px; color:var(--reasoning);}
.msg-reasoning-content{
  color:var(--text-secondary); white-space:pre-wrap; word-break:break-word;
  font-style:italic; line-height:1.5; max-height:200px; overflow-y:auto;
  font-size:12px; padding:2px 0;
}

/* Thinking badge */
.thinking-badge{
  display:inline-flex; align-items:center; gap:6px;
  color:var(--reasoning); font-size:12px; font-weight:500;
  padding:4px 0 8px;
}
.thinking-badge i{animation:thinkBrain 1.2s var(--ease) infinite;}
@keyframes thinkBrain{
  0%,100%{opacity:.6; transform:scale(1);}
  50%{opacity:1; transform:scale(1.08);}
}

/* ---------- Skeleton loaders ---------- */
.skeleton-wrap{display:flex; flex-direction:column; gap:22px; padding:6px 0 20px;}
.skeleton-msg{display:flex; gap:14px;}
.skeleton-avatar{width:30px; height:30px; border-radius:9px; background:var(--bg-elevated-2); flex:0 0 auto; animation:shimmer 1.6s ease-in-out infinite;}
.skeleton-lines{flex:1; display:flex; flex-direction:column; gap:9px; padding-top:4px;}
.skeleton-lines span{height:11px; border-radius:6px; background:var(--bg-elevated-2); animation:shimmer 1.6s ease-in-out infinite;}
@keyframes shimmer{0%,100%{opacity:1;} 50%{opacity:.45;}}

/* ---------- Error state ---------- */
.error-state{
  display:flex; align-items:center; gap:14px; padding:16px 18px; background:var(--danger-soft);
  border:1px solid color-mix(in srgb, var(--danger) 34%, transparent); border-radius:var(--radius-md); margin:10px 0;
}
.error-state i{color:var(--danger); font-size:20px; flex:0 0 auto;}
.error-state strong{display:block; font-size:13.5px; margin-bottom:2px;}
.error-state p{font-size:12.5px; color:var(--text-secondary);}
.error-state .error-detail{display:none; font-size:11px; color:var(--text-tertiary); margin-top:6px; padding-top:6px; border-top:1px solid color-mix(in srgb, var(--danger) 18%, transparent); font-family:var(--font-mono); word-break:break-word;}
.error-state .error-detail.expanded{display:block;}
.error-state .error-btns{display:flex;gap:8px;margin-left:auto;flex:0 0 auto;align-items:center;}
.error-state .error-detail-toggle{font-size:11px; padding:2px 8px; color:var(--text-secondary); background:transparent; border:1px solid var(--border-soft);}
.error-state .error-detail-toggle:hover{background:var(--bg-hover);}
.error-state .error-detail-toggle[aria-expanded="true"] i{transform:rotate(180deg);}
.error-state.backend-down{flex-direction:column;align-items:flex-start;gap:12px;}
.error-state.backend-down .backend-down-header{display:flex;align-items:center;gap:12px;}
.error-state.backend-down i{font-size:24px;}
.error-state.backend-down pre{width:100%;background:var(--bg-elevated-2);padding:10px 12px;border-radius:8px;font-family:var(--font-mono);font-size:12px;margin:0;overflow-x:auto;}
.error-state.backend-down .comment{color:var(--text-tertiary);}
.error-state.backend-down .btn-secondary{margin-top:4px;}

/* ---------- Scroll to latest ---------- */
.scroll-bottom-btn{
  position:absolute; bottom:14px; left:50%; transform:translateX(-50%);
  width:36px; height:36px; border-radius:50%; background:var(--bg-elevated); border:1px solid var(--border);
  color:var(--text-secondary); display:flex; align-items:center; justify-content:center;
  box-shadow:var(--shadow-2); z-index:15;
  transition:opacity var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
}
.scroll-bottom-btn:hover{background:var(--bg-hover); color:var(--text-primary); transform:translateX(-50%) translateY(-2px);}

/* ---------- Composer ---------- */
.composer-wrap{padding:0 20px 16px;}
.composer{
  max-width:var(--chat-max-w); margin:0 auto; background:var(--composer-bg);
  border:1px solid var(--border); border-radius:var(--radius-xl);
  box-shadow:var(--shadow-2); padding:10px 12px 8px; position:relative;
  transition:border-color var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
}
.composer:hover{border-color:var(--border-strong);}
.composer:focus-within{border-color:var(--accent); box-shadow:var(--shadow-2), 0 0 0 3px rgba(var(--accent-rgb),.16);}

.file-chips{display:flex; flex-wrap:wrap; gap:8px; padding:2px 4px 8px;}
.file-chip{
  display:flex; align-items:center; gap:9px; background:var(--bg-elevated); border:1px solid var(--border-soft);
  border-radius:var(--radius-sm); padding:7px 8px 7px 10px; font-size:12.5px; max-width:220px;
  animation:fadeUp var(--dur-fast) var(--ease);
}
.file-chip-icon{
  width:26px; height:26px; border-radius:7px; display:flex; align-items:center; justify-content:center;
  font-size:11px; color:#fff; flex:0 0 auto;
}
.file-chip-info{display:flex; flex-direction:column; min-width:0;}
.file-chip-name{overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-weight:500; word-break:break-all;}
.file-chip-size{color:var(--text-tertiary); font-size:10.5px;}
.file-chip-remove{background:transparent; border:none; color:var(--text-tertiary); padding:3px; border-radius:5px; flex:0 0 auto;}
.file-chip-remove:hover{background:var(--bg-hover); color:var(--danger);}

.composer-row{display:flex; align-items:flex-end; gap:8px;}
.composer-attach{width:34px; height:34px; margin-bottom:3px; color:var(--text-secondary);}
.composer-attach:hover{color:var(--accent); background:rgba(var(--accent-rgb),.12);}
.composer-attach:active{color:var(--accent); background:rgba(var(--accent-rgb),.18); transform:scale(.92);}
.composer-textarea{
  flex:1; resize:none; border:none; background:transparent; outline:none; color:var(--text-primary);
  font-size:calc(14.5px * var(--font-scale)); line-height:1.5; padding:9px 4px; max-height:140px; overflow-y:auto; font-family:var(--font-body);
}
.composer-textarea::placeholder{color:var(--text-tertiary);}

.send-btn{
  width:34px; height:34px; border-radius:50%; border:none; flex:0 0 auto; margin-bottom:3px;
  display:flex; align-items:center; justify-content:center; color:var(--on-accent);
  background:var(--accent); position:relative; overflow:hidden;
  box-shadow:0 1px 3px rgba(var(--accent-rgb),.25);
  transition:background var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
}
.send-btn:hover{background:color-mix(in srgb, var(--accent) 86%, var(--bg-surface)); box-shadow:0 2px 6px rgba(var(--accent-rgb),.3);}
.send-btn:active{transform:scale(.92);}
.send-btn:focus-visible{outline:none; box-shadow:var(--shadow-2), 0 0 0 3px rgba(var(--accent-rgb),.35);}
.send-btn:disabled{background:var(--bg-elevated-2); color:var(--text-disabled); cursor:not-allowed; box-shadow:none;}

/* Stop button — replaces the send button while generating (see chat.js setSendButtonState) */
#stopBtn{
  display:inline-flex; align-items:center; justify-content:center;
  width:34px; height:34px; border-radius:50%;
  background:var(--danger); border:none; color:var(--on-danger); font-size:15px;
  cursor:pointer; flex:0 0 auto; margin-bottom:3px;
  box-shadow:0 1px 3px rgba(194,67,67,.25);
  transition:background var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
}
#stopBtn:hover{background:var(--danger-strong); box-shadow:0 2px 6px rgba(194,67,67,.3);}
#stopBtn:active{transform:scale(.92);}
#stopBtn:focus-visible{outline:none; box-shadow:var(--shadow-2), 0 0 0 3px rgba(194,67,67,.3);}

.composer-controls{display:flex; align-items:center; gap:8px; padding:8px 6px 4px; flex-wrap:wrap; position:relative;}
.pill-control{
  display:flex; align-items:center; gap:7px; background:var(--bg-elevated); border:1px solid var(--border-soft);
  border-radius:999px; padding:5px 11px; font-size:12px; color:var(--text-secondary);
  transition:background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
}
.pill-control:hover{background:var(--bg-hover); border-color:var(--text-tertiary);}
.pill-control:active{background:var(--bg-active); border-color:var(--accent);}
.pill-control:focus-visible{border-color:var(--accent); box-shadow:0 0 0 2px rgba(var(--accent-rgb),.12); outline:none;}
.pill-control i{font-size:11px; transition:color var(--dur-fast) var(--ease);}
.pill-control b{color:var(--text-primary); font-weight:600;}
.toggle-pill{cursor:pointer; user-select:none;}
.toggle-pill.active{
  background:rgba(var(--accent-rgb),.14); border-color:var(--accent); color:var(--accent);
}
.composer-hint{margin-left:auto; font-size:11.5px; color:var(--text-tertiary); display:flex; align-items:center; gap:4px; white-space:nowrap;}
.composer-hint kbd{
  font-family:var(--font-mono); font-size:10px; line-height:1; padding:2px 4px; border-radius:4px;
  background:var(--bg-elevated-2); border:1px solid var(--border-soft); border-bottom-width:2px;
  color:var(--text-tertiary);
}

/* Settings modal select/input wraps */
.select-wrap select,
.select-wrap input[type="text"]{
  background:transparent; border:none; outline:none;
  font:inherit; font-size:12px; color:var(--text-primary);
  width:100%; cursor:pointer;
}
.select-wrap select option{background:var(--bg-elevated); color:var(--text-primary);}

/* Custom select dropdowns (token & reasoning) */
.composer-select{
  display:flex; align-items:center; gap:5px;
  background:var(--bg-elevated); border:1px solid var(--border-soft);
  border-radius:999px; padding:4px 4px 4px 9px;
  font-size:12px; position:relative;
  transition:background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
}
.composer-select:hover{background:var(--bg-hover);}
.composer-select:focus-within{border-color:var(--accent); box-shadow:0 0 0 2px rgba(var(--accent-rgb),.12);}
.composer-select > i:first-child{font-size:11px; flex-shrink:0;}
.composer-select > i:first-child,
.pill-control > i:first-child,
.select-btn i.fa-chevron-down,
.composer-attach{
  color:var(--text-secondary);
  transition:color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
}
.composer-select:hover > i:first-child,
.composer-select:focus-within > i:first-child,
.pill-control:hover > i:first-child,
.pill-control:active > i:first-child,
.toggle-pill.active > i:first-child,
.toggle-pill:hover > i:first-child,
.select-btn:hover i.fa-chevron-down,
.select-btn:active i.fa-chevron-down,
.composer-select:focus-within .select-btn i.fa-chevron-down,
.composer-attach:hover,
.composer-attach:active{color:var(--accent);}

.select-btn{
  display:flex; align-items:center; gap:4px;
  background:transparent; border:none; outline:none;
  font:inherit; font-size:12px; font-weight:500;
  color:var(--text-primary); cursor:pointer;
  padding:2px 6px 2px 2px; line-height:1; white-space:nowrap;
}
.select-btn i.fa-chevron-down{font-size:9px; transition:color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);}
.composer-select:focus-within .select-btn i.fa-chevron-down{transform:rotate(180deg);}

.select-dropdown{
  position:absolute; bottom:calc(100% + 6px); left:0; z-index:30;
  min-width:130px; background:var(--bg-elevated);
  border:1px solid var(--border); border-radius:var(--radius-md);
  box-shadow:var(--shadow-3);
  padding:4px; display:flex; flex-direction:column;
}
#tokenDropdown{min-width:105px;}
.select-dropdown button{
  display:flex; align-items:center; gap:8px;
  background:transparent; border:none; outline:none;
  font:inherit; font-size:12px; color:var(--text-secondary);
  padding:7px 10px; cursor:pointer; border-radius:var(--radius-sm);
  text-align:left; width:100%;
  transition:background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.select-dropdown button:hover{background:var(--bg-hover); color:var(--text-primary);}
.select-dropdown button.selected{
  color:var(--accent); font-weight:600;
  background:rgba(var(--accent-rgb),.08);
  position:relative; padding-left:28px;
}
.select-dropdown button.selected::before{
  content:'\f00c'; font-family:'Font Awesome 6 Free'; font-weight:900;
  font-size:9px; position:absolute; left:10px; top:50%; transform:translateY(-50%);
}

.temp-popover{
  position:absolute; bottom:calc(100% + 10px); left:0; width:240px; background:var(--bg-elevated);
  border:1px solid var(--border); border-radius:var(--radius-md); padding:14px 16px; box-shadow:var(--shadow-3);
  z-index:20; animation:fadeUp var(--dur-fast) var(--ease);
}
.temp-popover label{display:flex; justify-content:space-between; font-size:12.5px; font-weight:600; margin-bottom:10px; color:var(--text-primary);}
.temp-popover label span{color:var(--accent); font-weight:700; font-family:var(--font-mono); font-size:13px;}
.temp-popover input[type=range]{
  width:100%; accent-color:var(--accent); margin-bottom:8px; cursor:pointer;
}
.temp-popover input[type=range]:focus{outline:2px solid rgba(var(--accent-rgb),.4); outline-offset:4px; border-radius:4px;}
.temp-scale{display:flex; justify-content:space-between; font-size:10.5px; color:var(--text-tertiary);}

/* Token counter */
.token-counter{
  display:inline-flex; align-items:center; gap:5px;
  font-size:10.5px; font-weight:500; color:var(--text-tertiary); white-space:nowrap;
  padding:3px 8px; border-radius:999px; background:var(--bg-elevated);
  border:1px solid var(--border-soft); margin-left:auto; cursor:default;
  transition:color 150ms ease, border-color 150ms ease, background 150ms ease;
}
.token-counter.warning{color:var(--warning); border-color:color-mix(in srgb, var(--warning) 35%, transparent); background:var(--warning-soft);}
.token-counter.danger{color:var(--danger); border-color:color-mix(in srgb, var(--danger) 35%, transparent); background:var(--danger-soft);}

/* ---------- Modals ---------- */
.modal-overlay{
  position:fixed; inset:0; background:rgba(10,10,12,.6);
  z-index:300; display:flex; align-items:center; justify-content:center; padding:20px;
  animation:overlayIn var(--dur-fast) var(--ease);
}
@keyframes overlayIn{from{opacity:0;} to{opacity:1;}}
.modal{
  background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-lg);
  box-shadow:var(--shadow-3);
  width:100%; max-width:560px; max-height:85vh; display:flex; flex-direction:column; overflow:hidden;
  animation:modalIn var(--dur-med) var(--ease);
}
@keyframes modalIn{from{opacity:0; transform:translateY(14px) scale(.98);} to{opacity:1; transform:translateY(0) scale(1);}}
.modal-header{
  display:flex; align-items:center; justify-content:space-between; padding:18px 20px; border-bottom:1px solid var(--border-soft);
}
.modal-header h2{font-size:17px; display:flex; align-items:center; gap:9px;}

.settings-tabs{display:flex;gap:2px;background:var(--bg-elevated);border-bottom:1px solid var(--border-soft);padding:4px 8px 0;position:sticky;top:0;z-index:1;}
.settings-tab{
  background:transparent; border:none; padding:10px 16px; font-size:12.5px; font-weight:600; color:var(--text-secondary);
  cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-1px; transition:all var(--dur-fast) var(--ease);
  display:flex; align-items:center; gap:7px; border-radius:var(--radius-sm) var(--radius-sm) 0 0;
}
.settings-tab:hover{color:var(--text-primary);background:var(--bg-hover);}
.settings-tab.active{color:var(--accent);border-bottom-color:var(--accent);background:rgba(var(--accent-rgb),.06);}
.settings-tab i{font-size:11px;}
.settings-tabpanel{display:block;}
.settings-tabpanel[hidden]{display:none;}
.settings-body{overflow-y:auto; padding:6px 20px 20px;}
.settings-section{padding:14px 0; border-bottom:1px solid var(--border-soft);}
.settings-section:last-child{border-bottom:none;}
.settings-section h3{font-size:12px; text-transform:uppercase; letter-spacing:.06em; color:var(--text-tertiary); margin-bottom:12px;}
.settings-hint{font-size:12px;color:var(--text-tertiary);margin:-6px 0 12px;}

.setting-row{display:flex; align-items:center; justify-content:space-between; gap:16px; padding:12px 0; flex-wrap:wrap;}
.setting-row > *{min-width:0;}
.setting-label{display:flex; flex-direction:column; gap:2px;}
.setting-label span{font-size:13.5px; font-weight:500;}
.setting-label small{font-size:11.5px; color:var(--text-tertiary);}
.setting-control{display:flex; align-items:center; gap:8px; flex-wrap:wrap;}
.setting-control .input-mono{font-family:var(--font-mono); font-size:13px; padding:6px 10px; border-radius:8px; border:1px solid var(--border); background:var(--input-bg); color:var(--text-primary); width:260px;}
.setting-control .input-mono:focus{outline:none; border-color:var(--accent); box-shadow:0 0 0 2px rgba(var(--accent-rgb),.12);}
.backend-test-result{font-size:12px; font-weight:500;}

.theme-options{display:flex; gap:6px;}
.theme-option{
  display:flex; align-items:center; gap:6px; padding:7px 12px; border-radius:var(--radius-sm);
  background:var(--bg-elevated); border:1px solid var(--border-soft); font-size:12.5px; color:var(--text-secondary);
  transition:all var(--dur-fast) var(--ease);
}
.theme-option:hover{background:var(--bg-hover);}
.theme-option.active{border-color:var(--accent); color:var(--accent); background:rgba(var(--accent-rgb),.08);}

.segmented{display:flex; background:var(--bg-elevated); border:1px solid var(--border-soft); border-radius:var(--radius-sm); padding:3px;}
.segmented button{padding:6px 12px; border:none; background:transparent; border-radius:6px; font-size:12.5px; color:var(--text-secondary);}
.segmented button:hover{background:var(--bg-hover);}
.segmented button.active{background:var(--bg-elevated-2); color:var(--text-primary); font-weight:600;}

.switch{display:inline-flex; cursor:pointer;}
.switch input{display:none;}
.switch-track{
  width:40px; height:23px; background:var(--bg-elevated-2); border:1px solid var(--border); border-radius:999px;
  position:relative; transition:background var(--dur-fast) var(--ease);
}
.switch-thumb{
  position:absolute; top:2px; left:2px; width:17px; height:17px; border-radius:50%; background:var(--bg-surface);
  transition:transform var(--dur-fast) var(--ease); box-shadow:var(--shadow-1);
}
.switch input:checked + .switch-track{background:var(--accent);}
.switch input:checked + .switch-track .switch-thumb{transform:translateX(17px);}

.provider-status-list{display:flex; flex-direction:column; gap:2px;}
.provider-status-row{display:flex; align-items:center; gap:10px; padding:9px 4px; flex-wrap:wrap;}
.provider-status-row .provider-dot{width:8px; height:8px;}
.provider-status-row .provider-label{font-size:13px; flex:1;}
.provider-status-row .provider-state{font-size:11.5px; color:var(--text-tertiary);}
.provider-status-row .provider-state.online{color:var(--success);}
.provider-status-row .provider-state.local{color:var(--warning);}

.provider-key-input{
  flex:1; min-width:0;
  background:var(--input-bg);
  border:1px solid var(--border-soft);
  border-radius:var(--radius-sm);
  padding:6px 10px;
  font-size:12.5px;
  color:var(--text-primary);
}
.provider-key-input:focus{outline:none; border-color:var(--accent); box-shadow:0 0 0 2px rgba(var(--accent-rgb),.12);}

/* ---------- Confirm Dialog ---------- */
.confirm-overlay{
  position:fixed; inset:0; background:rgba(10,10,12,.6);
  z-index:400; display:flex; align-items:center; justify-content:center; padding:20px;
  animation:overlayIn var(--dur-fast) var(--ease);
}
.confirm-dialog{
  background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-lg);
  padding:24px; max-width:380px; width:100%; box-shadow:var(--shadow-3);
  animation:modalIn var(--dur-med) var(--ease);
}
.confirm-dialog h3{font-size:16px; margin-bottom:8px;}
.confirm-dialog p{font-size:13.5px; color:var(--text-secondary); margin-bottom:20px;}
.confirm-actions{display:flex; gap:10px; justify-content:flex-end;}
.confirm-actions .btn-secondary:focus-visible,
.confirm-actions .btn-danger:focus-visible{outline:3px solid var(--focus-ring); outline-offset:2px;}
.onboarding-card .btn-secondary:focus-visible{outline:3px solid var(--focus-ring); outline-offset:2px;}

/* ---------- Toasts ---------- */
.toast-container{position:fixed; top:18px; right:18px; z-index:200; display:flex; flex-direction:column; gap:10px; width:320px;}
.toast{
  display:flex; align-items:flex-start; gap:10px; background:var(--bg-elevated); border:1px solid var(--border);
  border-left-width:3px; border-radius:var(--radius-md); padding:12px 14px; box-shadow:var(--shadow-3);
  animation:toastIn var(--dur-med) var(--ease); position:relative; overflow:hidden;
}
.toast.success{border-left-color:var(--success);}
.toast.error{border-left-color:var(--danger);}
.toast.info{border-left-color:var(--accent);}
@keyframes toastIn{from{opacity:0; transform:translateX(30px);} to{opacity:1; transform:translateX(0);}}
.toast.leaving{animation:toastOut var(--dur-fast) var(--ease) forwards;}
@keyframes toastOut{to{opacity:0; transform:translateX(30px);}}
.toast i{font-size:15px; margin-top:1px; flex:0 0 auto;}
.toast.success i{color:var(--success);}
.toast.error i{color:var(--danger);}
.toast.info i{color:var(--accent);}
.toast-text{font-size:13px; flex:1;}
.toast-text strong{display:block; font-size:13px; margin-bottom:1px;}
.toast-close{background:transparent; border:none; color:var(--text-tertiary); font-size:11px; flex:0 0 auto; cursor:pointer;}
.toast-bar{position:absolute; bottom:0; left:0; height:3px; width:100%; background:currentColor; opacity:.2; border-radius:0 0 var(--radius-md) var(--radius-md); transform-origin:left;}
.toast.success .toast-bar{background:var(--success);}
.toast.error .toast-bar{background:var(--danger);}
.toast.info .toast-bar{background:var(--accent);}
@keyframes toastShrink{from{transform:scaleX(1);} to{transform:scaleX(0);}}

/* ---------- Chat width / font-size variants ---------- */
body[data-chat-width="narrow"] .chat-column,
body[data-chat-width="narrow"] .composer{--chat-max-w:620px;}
body[data-chat-width="wide"] .chat-column,
body[data-chat-width="wide"] .composer{--chat-max-w:960px;}

body[data-font-size="sm"]{--font-scale:.92;}
body[data-font-size="lg"]{--font-scale:1.1;}

/* Disable animations */
body[data-animations="off"] *{animation:none !important; transition:none !important;}

/* ---------- Sidebar context menu ---------- */
.chat-context-menu{
  position:fixed; z-index:100; min-width:160px;
  background:var(--bg-elevated); border:1px solid var(--border);
  border-radius:var(--radius-md); padding:4px;
  box-shadow:var(--shadow-3); display:none;
}
.chat-context-menu.show{display:block;}
.chat-context-menu button{
  display:flex; align-items:center; gap:8px; width:100%;
  padding:7px 12px; border:none; background:transparent;
  color:var(--text-primary); font-size:12.5px; cursor:pointer;
  border-radius:6px; transition:background 150ms ease; text-align:left;
}
.chat-context-menu button:hover{background:var(--bg-hover);}
.chat-context-menu button i{width:16px; text-align:center; font-size:12px; color:var(--text-tertiary);}
.chat-context-menu .ctx-menu-danger{color:var(--danger);}
.chat-context-menu .ctx-menu-danger i{color:var(--danger);}
.chat-context-menu .ctx-menu-divider{height:1px; background:var(--border); margin:4px 0;}

.chat-item .chat-rename-input{
  flex:1; min-width:0;
  background:var(--input-bg); border:1px solid var(--accent);
  border-radius:4px; padding:2px 8px; font-size:12.5px; height:24px;
  color:var(--text-primary); outline:none;
}
.chat-item .chat-item-pin{font-size:10px; color:var(--text-tertiary); flex:0 0 auto; opacity:0; transition:opacity 150ms ease, color 150ms ease;}
.chat-item:hover .chat-item-pin{opacity:1;}
.chat-item.pinned{background:rgba(var(--accent-rgb),.06);}
.chat-item.pinned .chat-item-pin{opacity:1; color:var(--warning);}
.chat-item.pinned .chat-icon{color:var(--warning);}
.chat-item-menu-btn{
  display:inline-flex; align-items:center; justify-content:center;
  width:22px; height:22px; border-radius:4px; border:none;
  background:transparent; color:var(--text-tertiary); font-size:12px;
  flex:0 0 auto; opacity:0; cursor:pointer;
  transition:background 150ms ease, color 150ms ease, opacity 150ms ease;
}
.chat-item:hover .chat-item-menu-btn{opacity:1;}
.chat-item-menu-btn:hover{background:var(--bg-hover); color:var(--text-primary);}

/* ---------- Skills Modal ---------- */
.skills-modal{max-width:900px; max-height:85vh;}
.skills-layout{display:flex; overflow:hidden; flex:1; min-height:400px;}
.skills-sidebar{
  width:200px; flex:0 0 200px; border-right:1px solid var(--border-soft);
  display:flex; flex-direction:column; gap:16px; padding:16px; overflow-y:auto;
}
.skills-search-wrap{
  display:flex; align-items:center; gap:8px; background:var(--bg-elevated);
  border:1px solid var(--border-soft); border-radius:var(--radius-md); padding:9px 12px;
}
.skills-search-wrap i{color:var(--text-tertiary); font-size:12px;}
.skills-search-wrap input{background:transparent; border:none; outline:none; width:100%; font-size:13px; color:var(--text-primary);}
.skills-categories,.skills-invocations{display:flex; flex-direction:column; gap:2px;}
.skills-categories::before{content:'Category'; display:block; font-size:10px; font-weight:600; text-transform:uppercase; letter-spacing:.06em; color:var(--text-tertiary); margin-bottom:4px;}
.skills-invocations::before{content:'Trigger'; display:block; font-size:10px; font-weight:600; text-transform:uppercase; letter-spacing:.06em; color:var(--text-tertiary); margin-bottom:4px;}
.skills-categories button,.skills-invocations button{
  display:block; width:100%; text-align:left; padding:6px 10px; border-radius:var(--radius-sm);
  border:none; background:transparent; font-size:12.5px; color:var(--text-secondary); cursor:pointer;
  transition:background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.skills-categories button:hover,.skills-invocations button:hover{background:var(--bg-hover); color:var(--text-primary);}
.skills-categories button.active,.skills-invocations button.active{background:rgba(var(--accent-rgb),.1); color:var(--accent); font-weight:600;}

.skills-list{width:280px; flex:0 0 280px; border-right:1px solid var(--border-soft); overflow-y:auto; padding:8px;}
.skill-category{margin-bottom:16px;}
.skill-category h4{font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.05em; color:var(--text-tertiary); padding:8px; margin-bottom:4px;}
.skill-grid{display:flex; flex-direction:column; gap:2px;}
.skill-card{
  display:flex; align-items:center; gap:8px; padding:8px 10px; border-radius:var(--radius-sm);
  background:transparent; border:1px solid transparent; font-size:12.5px; color:var(--text-secondary);
  text-align:left; transition:background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.skill-card:hover{background:var(--bg-hover); color:var(--text-primary);}
.skill-card.selected{background:rgba(var(--accent-rgb),.1); border-color:rgba(var(--accent-rgb),.3); color:var(--accent);}
.skill-card span:first-child{flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
.skill-card span:nth-child(2){font-size:10px; color:var(--text-tertiary); white-space:nowrap;}
.inv-auto{background:var(--success-soft); color:var(--success); font-size:9px; font-weight:600; padding:2px 6px; border-radius:4px; white-space:nowrap;}
.inv-user{background:rgba(var(--accent-rgb),.15); color:var(--accent); font-size:9px; font-weight:600; padding:2px 6px; border-radius:4px; white-space:nowrap;}
.inv-both{background:var(--warning-soft); color:var(--warning); font-size:9px; font-weight:600; padding:2px 6px; border-radius:4px; white-space:nowrap;}

.skills-detail{flex:1; overflow-y:auto; padding:20px;}
.skills-detail .placeholder{color:var(--text-tertiary); text-align:center; padding:40px 20px;}
.skills-detail h3{margin-bottom:8px;}
.skills-detail .badges{display:flex; gap:6px; flex-wrap:wrap; margin-bottom:12px;}
.skills-detail .badge{font-size:10px; font-weight:600; padding:3px 8px; border-radius:999px;}
.badge.cat-engineering{background:rgba(var(--accent-rgb),.15); color:var(--accent);}
.badge.cat-design{background:var(--danger-soft); color:var(--danger);}
.badge.cat-behavioral{background:var(--warning-soft); color:var(--warning);}
.badge.cat-productivity{background:var(--success-soft); color:var(--success);}
.badge.cat-knowledge{background:var(--info-soft); color:var(--info);}
.badge.cat-system{background:var(--bg-elevated-2); color:var(--text-secondary);}
.badge.cat-personal{background:var(--reasoning-soft); color:var(--reasoning);}
.badge.cat-misc{background:var(--bg-elevated-2); color:var(--text-tertiary);}
.badge.inv-auto{background:var(--success-soft); color:var(--success);}
.badge.inv-user{background:rgba(var(--accent-rgb),.15); color:var(--accent);}
.badge.inv-both{background:var(--warning-soft); color:var(--warning);}
.badge.src{background:var(--bg-elevated-2); color:var(--text-secondary);}

.skills-detail p{margin-bottom:14px; color:var(--text-secondary); font-size:13.5px;}
.skills-detail h4{font-size:12.5px; margin:16px 0 6px; color:var(--text-tertiary); text-transform:uppercase; letter-spacing:.04em;}
.skills-detail .pi{display:flex; flex-direction:column; gap:4px; margin-bottom:10px;}
.skills-detail .pi label{display:flex; flex-direction:column; gap:3px; font-size:12px;}
.skills-detail .pi label span{font-size:10px; color:var(--text-tertiary);}
.skills-detail .pi input{background:var(--input-bg); border:1px solid var(--border-soft); border-radius:var(--radius-sm); padding:6px 10px; font-size:12px; color:var(--text-primary);}
.skills-detail .pi input:focus{outline:none; border-color:var(--accent);}
.skills-detail button{padding:8px 16px; border-radius:var(--radius-sm); font-size:12.5px; font-weight:500; margin-right:8px; margin-top:8px;}
.skills-detail #exBtn,.skills-detail #executeSkillBtn{background:var(--accent); color:var(--on-accent); border:none;}
.skills-detail #exBtn:hover,.skills-detail #executeSkillBtn:hover{filter:brightness(1.1);}
.skills-detail #chBtn,.skills-detail #cpBtn,.skills-detail #copySkillBtn{background:var(--bg-elevated); border:1px solid var(--border); color:var(--text-primary);}
.skills-detail #chBtn:hover,.skills-detail #cpBtn:hover,.skills-detail #copySkillBtn:hover{background:var(--bg-hover);}
.skill-result{margin-top:16px;}
.skill-result pre{white-space:pre-wrap; overflow-wrap:anywhere; background:var(--bg-elevated); border-radius:var(--radius-sm); padding:10px; font-size:12px;}
.loading{display:flex; align-items:center; justify-content:center; height:200px; color:var(--text-tertiary);}

/* ---------- Keyboard Shortcuts Modal ---------- */
.shortcuts-modal{max-width:520px;}
.shortcuts-body{padding:20px;}
.shortcuts-grid{display:flex; flex-direction:column; padding:8px 20px 20px;}
.shortcut-row{
  display:flex; align-items:center; gap:6px; padding:9px 4px; font-size:13px;
  border-bottom:1px solid var(--border-soft); color:var(--text-primary);
}
.shortcut-row:last-child{border-bottom:none;}
.shortcut-row kbd{margin:0;}
.shortcut-row span{margin-left:auto; color:var(--text-secondary); font-size:12.5px;}
.shortcuts-table{width:100%;border-collapse:collapse;font-size:13px;}
.shortcuts-table thead tr{border-bottom:1px solid var(--border);}
.shortcuts-table th{text-align:left;padding:8px 0;color:var(--text-secondary);font-weight:600;}
.shortcuts-table th:last-child{text-align:right;}
.shortcuts-table td{padding:8px 0;}
.shortcuts-table td:first-child{color:var(--text-primary);}
.shortcuts-table td:last-child{text-align:right;color:var(--text-secondary);}
.shortcuts-table kbd{
  font-family:var(--font-mono);font-size:11px;background:var(--bg-elevated-2);
  border:1px solid var(--border);border-bottom-width:2px;border-radius:5px;
  padding:2px 6px;color:var(--text-secondary);margin:0 2px;
}
.shortcuts-table kbd + kbd{margin-left:4px;}
.shortcuts-note{margin-top:16px;font-size:12px;color:var(--text-tertiary);text-align:center;}

/* ---------- Auth ---------- */
.auth-loading{display:flex;flex-direction:column;align-items:center;gap:16px;padding:48px 32px;text-align:center;}
.auth-loading .auth-logo{width:52px;height:52px;margin:0;opacity:.7;}
.auth-loading-text{color:var(--text-primary);font:500 18px var(--font-display);margin:0;min-height:1.4em;}
.auth-loading-text::after{content:'';animation:loadDots 1.8s steps(4,end) infinite;}
.auth-loading-text--done::after{content:none;animation:none;}
@keyframes loadDots{0%{content:''}25%{content:'.'}50%{content:'..'}75%{content:'...'}100%{content:''}}
.auth-loading-sub{color:var(--text-tertiary);font:13px var(--font-body);margin:0;}
.auth-loading-retry{display:flex;flex-direction:column;align-items:center;gap:10px;width:100%;}
.auth-loading-errmsg{color:var(--danger);font:13px var(--font-body);margin:0;text-align:center;}
.auth-retry-btn{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--accent);border-radius:var(--radius-sm);background:transparent;color:var(--accent);padding:9px 18px;font:500 13px var(--font-body);cursor:pointer;transition:background 150ms ease,color 150ms ease;}
.auth-retry-btn:hover{background:var(--accent);color:var(--on-accent);}
.auth-retry-btn i{font-size:13px;}
.auth-loading-spinner{position:relative;width:60px;height:60px;margin-bottom:4px;}
.spinner-ring{position:absolute;inset:0;border:3px solid transparent;border-top-color:var(--accent);border-radius:50%;animation:spin 1s linear infinite;}
.spinner-ring::before{content:'';position:absolute;inset:4px;border:3px solid transparent;border-bottom-color:var(--accent-soft);border-radius:50%;animation:spin 1.4s reverse linear infinite;}
.spinner-dot{position:absolute;top:50%;left:50%;width:8px;height:8px;margin:-4px 0 0 -4px;background:var(--accent);border-radius:50%;animation:pulseDot 1.2s ease-in-out infinite;}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes pulseDot{0%,100%{opacity:.3;transform:scale(.8)}50%{opacity:1;transform:scale(1.2)}}

.auth-overlay{position:fixed;inset:0;z-index:500;display:flex;align-items:center;justify-content:center;padding:20px;background:radial-gradient(circle at 15% 10%,var(--bg-elevated-2),transparent 40%),var(--bg-base);}
.auth-card{width:min(100%,420px);display:flex;flex-direction:column;gap:10px;padding:32px;border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--surface-raised);box-shadow:var(--shadow-3);}
.auth-logo{width:42px;height:42px;margin-bottom:4px}
.auth-kicker{margin:0;color:var(--accent);font:600 11px var(--font-mono);letter-spacing:.1em}
.auth-card h1{margin:0;font-size:25px}
.auth-card p{margin:0;color:var(--text-secondary);font-size:13px;line-height:1.5}
.auth-card label{margin-top:6px;color:var(--text-secondary);font-size:12px;font-weight:600}
.auth-card input{width:100%;box-sizing:border-box;margin-top:5px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--input-bg);color:var(--text-primary);padding:11px 12px;font:14px var(--font-body)}
.auth-card input:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 2px rgba(var(--accent-rgb),.12);}
.auth-submit{margin-top:8px;border:0;border-radius:var(--radius-sm);background:var(--accent);color:var(--on-accent);padding:11px 14px;font-weight:700;cursor:pointer}
.auth-submit:disabled{opacity:.65;cursor:wait}
.auth-error{color:var(--danger)!important}
.auth-note{color:var(--text-tertiary)!important;font-size:11px!important}
.auth-forgot-link{margin:0;text-align:center}
.auth-link-btn{background:none;border:none;color:var(--accent);font:inherit;font-size:12px;cursor:pointer;padding:0;text-decoration:none}
.auth-link-btn:hover{text-decoration:underline}
.auth-alt-form{width:min(100%,420px);display:flex;flex-direction:column;gap:10px;padding:32px;border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--surface-raised);box-shadow:var(--shadow-3);}
.auth-alt-form h1{margin:0;font-size:25px}
.auth-alt-form p{margin:0;color:var(--text-secondary);font-size:13px;line-height:1.5}
.auth-alt-form label{margin-top:6px;color:var(--text-secondary);font-size:12px;font-weight:600}
.auth-alt-form input{width:100%;box-sizing:border-box;margin-top:5px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--input-bg);color:var(--text-primary);padding:11px 12px;font:14px var(--font-body)}
.auth-alt-form input:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 2px rgba(var(--accent-rgb),.12);}
.auth-token-box{margin-top:4px;padding:14px;background:var(--bg-elevated-2);border:1px solid var(--border);border-radius:var(--radius-sm);display:flex;flex-direction:column;gap:10px}
.auth-token-box p{margin:0;font-size:12px;color:var(--text-secondary)}
.auth-token-box code{display:block;padding:10px;background:var(--bg-base);border:1px dashed var(--border);border-radius:var(--radius-sm);font:12px/1.5 var(--font-mono);color:var(--accent);word-break:break-all;user-select:all}
.auth-token-actions{display:flex;gap:8px;align-items:center}
.auth-copy-btn{background:transparent;border:1px solid var(--border);border-radius:var(--radius-sm);padding:8px 12px;font-size:12px;cursor:pointer;color:var(--text-secondary);transition:border-color var(--dur-fast) var(--ease),color var(--dur-fast) var(--ease)}
.auth-copy-btn:hover{border-color:var(--accent);color:var(--accent)}
.auth-back-link{margin:0;text-align:center}
.auth-success{color:var(--success)!important;font-size:13px!important}

/* ---------- Responsive ---------- */
@media (max-width:900px){
  .mobile-topbar{display:flex;}
  .app-shell{height:calc(100vh - 52px);}
  .sidebar{
    position:fixed; top:52px; bottom:0; left:0; z-index:50; width:280px;
    transform:translateX(-100%); transition:transform var(--dur-med) var(--ease); box-shadow:var(--shadow-3);
    will-change:transform;
  }
  .sidebar.mobile-open{transform:translateX(0);}
  .sidebar.collapsed{width:280px;}
  .sidebar-inner{width:280px;}
  .sidebar-scrim.show{display:block;}
  .expand-btn{display:none !important;}
  .topbar{padding:8px 12px;}
  .icon-btn{width:40px; height:40px;}
  .icon-btn.ghost{width:36px; height:36px;}
  .model-name{display:none;}
  .conn-pulse span:last-child{display:none;}
  .chat-column{padding:18px 14px 8px;}
  .suggestion-grid{grid-template-columns:1fr;}
  .composer-wrap{padding:0 10px 12px;}
  .welcome-screen h1{font-size:24px;}
  .welcome-keyhints{font-size:10px; gap:4px;}
  .onboarding-card{flex-direction:column; align-items:center; text-align:center; padding:14px;}
  .onboarding-card .btn-secondary{width:100%;}
  .toast-container{left:12px; right:12px; width:auto;}

  .modal{max-width:100%;max-height:100vh;border-radius:0;height:100%;}
  .modal-overlay{padding:0;align-items:flex-end;}
  .settings-modal{max-height:100vh;}
  .settings-modal .settings-body{padding:6px 14px 20px;}
  .settings-tabs{justify-content:stretch; padding:4px 4px 0;}
  .settings-tab{flex:1; justify-content:center; text-align:center; padding:12px 8px; font-size:11.5px;border-radius:var(--radius-sm) var(--radius-sm) 0 0;}

  .auth-card{padding:24px 20px;}
  .auth-alt-form{padding:24px 20px;}

  .model-dropdown{position:fixed;top:auto;bottom:0;left:0;right:0;width:100%;max-height:70vh;border-radius:var(--radius-lg) var(--radius-lg) 0 0;transform:translateY(100%);transition:transform var(--dur-med) var(--ease),opacity var(--dur-fast) var(--ease);}
  .model-selector.open .model-dropdown{transform:translateY(0);}

  .temp-popover{left:0;right:auto;width:200px;}
  .msg-actions{opacity:1;}
  .msg-meta{flex-wrap:wrap; gap:6px;}
  .msg-response-time{margin-left:0; order:9999; width:100%; text-align:right; padding-top:2px;}

  .skills-layout{flex-direction:column;}
  .skills-sidebar{width:100%; flex:0 0 auto; border-right:none; border-bottom:1px solid var(--border-soft); flex-direction:row; flex-wrap:wrap; gap:8px; padding:12px;}
  .skills-search-wrap{flex:1; min-width:160px;}
  .skills-categories,.skills-invocations{flex-direction:row; flex-wrap:wrap; gap:4px;}
  .skills-categories::before,.skills-invocations::before{display:none;}
  .skills-list{width:100%; flex:0 0 auto; border-right:none; border-bottom:1px solid var(--border-soft); max-height:200px;}
  .skills-detail{flex:1; min-height:300px;}
}

@media (min-width:901px){
  .sidebar.collapsed + .sidebar-scrim{display:none;}
}

/* ---------- Reduced motion ---------- */
@media (prefers-reduced-motion:reduce){
  *{animation-duration:.001ms !important; transition-duration:.001ms !important;}
  .sidebar{transition:none !important;}
  .sidebar-scrim{transition:none !important;}
}

/* ---------- Forced colors (Windows High Contrast) ---------- */
/* Buttons that suppress the default outline keep a visible focus indicator
   when system contrast themes strip box-shadows. */
@media (forced-colors: active){
  .send-btn:focus-visible, #stopBtn:focus-visible{outline:2px solid CanvasText; outline-offset:2px;}
}
/* Citations test */
