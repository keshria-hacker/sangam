# Application
APP_NAME=UniversalAI
ENV=development
APP_DEBUG=false
API_PREFIX=/api
ALLOWED_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]

# ⚠️ REQUIRED for API key encryption — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=

# Storage
MAX_UPLOAD_SIZE_MB=25

# Cloud providers (add only the keys you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_NIM_API_KEY=
TOGETHER_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OMNIROUTE_API_KEY=

# Provider and local-runtime endpoints
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
OLLAMA_BASE_URL=http://localhost:11434
LM_STUDIO_BASE_URL=http://localhost:1234/v1
VLLM_BASE_URL=http://localhost:8001/v1

# Redis (optional — distributed rate limiting)
# Set this to enable Redis-backed rate limiting. Falls back to in-memory when unset.
# When running under Docker Compose with --profile redis, use:
# REDIS_URL=redis://redis:6379/0
REDIS_URL=

# Web search (optional — DuckDuckGo is the free default)
# Set a provider key to upgrade search quality:
# WEB_SEARCH_PROVIDER=tavily  or  brave
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=

# Response quality (optional — off by default)
# Remove AI slop patterns ("delve into", "tapestry", filler hedges) from responses.
QUALITY_NO_SLOP=false
# ADHD-friendly formatting: strip throat-clearing openers, reflow walls of text.
QUALITY_ADHD_FRIENDLY=false

# Feature flags (optional — all off by default except MCP)
# FEATURE_VOICE=false
# FEATURE_IMAGE_GEN=false
# FEATURE_MULTI_AGENT=false
# FEATURE_LEARNING=false
# FEATURE_ANALYTICS=false
